<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Installer"
        x:Class="Installer.MainWindow"
        Title="Ultimate MP3 Player Installer"
        Icon="avares://UltimateMP3PlayerInstaller/Assets/app.ico"
        Width="1120" Height="740" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0C0A14"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="38">
    <Panel>
        <Panel>
            <local:Aurora x:Name="AuroraBack"/>
            <local:Aurora x:Name="AuroraFront"/>
        </Panel>

        <Grid ColumnDefinitions="10*,11*">
            <!-- A Viewbox: the phone is one drawing at any window size, and the cable always reaches the bottom edge. -->
            <Viewbox Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,30,0,0" ClipToBounds="False">
                <local:PhoneView x:Name="Phone"/>
            </Viewbox>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="30,60,64,26">
                <StackPanel x:Name="Header" Spacing="10" Opacity="0" MaxWidth="500">
                    <TextBlock x:Name="StepLabel" Classes="eyebrow"/>
                    <local:Bar x:Name="StepBar" Height="4"/>
                </StackPanel>

                <Panel x:Name="Pages" Grid.Row="1" MaxWidth="500">

                    <!-- Welcome -->
                    <StackPanel x:Name="WelcomePage" IsVisible="False" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                            <Border CornerRadius="9" ClipToBounds="True" Width="36" Height="36">
                                <Image Source="avares://UltimateMP3PlayerInstaller/Assets/icon.png"/>
                            </Border>
                            <TextBlock Classes="eyebrow" VerticalAlignment="Center" Text="{local:T 'ULTIMATE MP3 PLAYER FOR IPHONE'}"/>
                        </StackPanel>
                        <TextBlock Classes="h1" FontSize="52" LineHeight="58" x:Name="WelcomeTitle"/>
                        <TextBlock Classes="sub" Margin="0,16,0,0" Text="{local:T 'Download it from almost any site and listen offline. Free, with no ads and no subscription.'}"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,24,0,0" x:Name="Features"/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0" Spacing="18">
                            <Button x:Name="StartButton" Classes="primary">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{local:T 'Install it now'}"/>
                                    <Path Classes="icon" Data="{StaticResource IconArrow}" Stroke="White" Width="17" Height="14.9" StrokeThickness="2.4" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="small" Margin="0,16,0,0" Text="{local:T 'I\'ll guide you. All it takes is a cable and your free Apple ID: about 5 minutes.'}"/>
                        <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,8,0,0">
                            <Button x:Name="WelcomeNeeds" Classes="link" Content="{local:T 'What it needs'}"/>
                            <Button x:Name="WhyButton" Classes="link" Content="{local:T 'Why isn\'t it on the App Store?'}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The computer -->
                    <StackPanel x:Name="ComputerPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Getting your computer ready'}"/>
                        <TextBlock Classes="sub" Margin="0,12,0,0" Text="{local:T 'It happens only once, and I do nearly all of it.'}"/>
                        <StackPanel x:Name="ComputerRows" Margin="0,26,0,0" Spacing="18"/>
                    </StackPanel>

                    <!-- The phone -->
                    <StackPanel x:Name="ConnectPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" x:Name="ConnectTitle" Text="{local:T 'Plug in your iPhone'}"/>
                        <TextBlock Classes="sub" x:Name="ConnectText" Margin="0,12,0,0" Text="{local:T 'Use the cable and unlock it. I\'ll recognize it by myself.'}"/>
                        <TextBlock x:Name="ConnectHelp" Classes="small" Margin="0,22,0,0" Text="{local:T 'Can\'t see it? Unplug the cable and plug it in again, with the iPhone unlocked. Still nothing: try another cable or port, some cables only charge.'}"/>
                        <Button x:Name="ConnectBack" Classes="link quiet" Margin="0,14,0,0" Content="{local:T 'Back'}"/>
                    </StackPanel>

                    <!-- The Apple ID -->
                    <StackPanel x:Name="AccountPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Sign in with your Apple ID'}"/>
                        <TextBlock Classes="sub" Margin="0,12,0,0" Text="{local:T 'Apple uses it to sign the app for your iPhone. It\'s free, and you won\'t buy anything.'}"/>
                        <StackPanel Margin="0,24,0,0" Spacing="12">
                            <TextBox x:Name="EmailBox" Classes="field" Watermark="{local:T 'Email'}"/>
                            <TextBox x:Name="PasswordBox" Classes="field" Watermark="{local:T 'Password'}" PasswordChar="•"/>
                        </StackPanel>
                        <TextBlock x:Name="AccountError" Classes="sub" FontSize="14.5" LineHeight="21" Foreground="{StaticResource Bad}" Margin="0,12,0,0" IsVisible="False"/>
                        <Button x:Name="AccountStatus" Classes="link" Margin="0,6,0,0" IsVisible="False" Content="{local:T 'Is Apple\'s sign-in down? Check its status page'}"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,18,0,0">
                            <Button x:Name="LoginButton" Classes="primary" Content="{local:T 'Continue'}"/>
                            <Button x:Name="AccountBack" Classes="link quiet" VerticalAlignment="Center" Content="{local:T 'Back'}"/>
                            <local:Spinner x:Name="LoginSpinner" IsVisible="False" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
                            <Path Classes="icon" Data="{StaticResource IconLock}" Stroke="{StaticResource Faint}" Width="12.6" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Classes="small" VerticalAlignment="Center" Text="{local:T 'Your password goes only to Apple, and it isn\'t saved.'}"/>
                        </StackPanel>
                        <Button x:Name="TrustButton" Classes="link" Margin="0,4,0,0" Content="{local:T 'Can I trust this?'}"/>
                    </StackPanel>

                    <!-- The code -->
                    <StackPanel x:Name="CodePage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Enter the code'}"/>
                        <TextBlock Classes="sub" Margin="0,12,0,0" Text="{local:T 'Apple sent a 6-digit code to your devices: tap Allow, then type it here.'}"/>
                        <TextBox x:Name="CodeBox" Classes="field code" Margin="0,26,0,0" MaxLength="6"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,20,0,0">
                            <Button x:Name="CodeButton" Classes="primary" Content="{local:T 'Continue'}"/>
                            <Button x:Name="CodeBack" Classes="link quiet" VerticalAlignment="Center" Content="{local:T 'Back'}"/>
                            <local:Spinner x:Name="CodeSpinner" IsVisible="False" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Installing -->
                    <StackPanel x:Name="InstallPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" x:Name="InstallTitle" Text="{local:T 'Installing the app'}"/>
                        <TextBlock x:Name="InstallSub" Classes="sub" Margin="0,12,0,0"/>
                        <TextBlock x:Name="InstallPercent" FontFamily="{StaticResource Display}" FontSize="76" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="0,22,0,0" Text="0%"/>
                        <local:Bar x:Name="InstallBar" Height="6" Margin="0,8,0,0"/>
                        <TextBlock x:Name="InstallStage" Classes="sub" FontSize="15" Margin="0,12,0,0"/>
                        <Button x:Name="InstallStop" Classes="link quiet" Margin="0,18,0,0" IsVisible="False" Content="{local:T 'Stop'}"/>
                    </StackPanel>

                    <!-- What the app on this computer has, for the one on the iPhone -->
                    <StackPanel x:Name="BringPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Bring your things too'}"/>
                        <TextBlock Classes="sub" Margin="0,10,0,0" FontSize="15.5" LineHeight="23" Text="{local:T 'Ultimate MP3 Player is on this computer too. Choose what to bring: it\'s added to what\'s on the iPhone, nothing is deleted.'}"/>
                        <StackPanel x:Name="BringRows" Margin="0,18,0,0" Spacing="8"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,20,0,0">
                            <Button x:Name="BringNext" Classes="primary" Content="{local:T 'Send it to the iPhone'}"/>
                            <Button x:Name="BringBack" Classes="link quiet" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The last two taps -->
                    <StackPanel x:Name="ActivatePage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Just two more taps'}"/>
                        <TextBlock Classes="sub" Margin="0,12,0,0" Text="{local:T 'You do them only once. Follow the phone beside this text.'}"/>
                        <StackPanel x:Name="ActivateCards" Margin="0,24,0,0" Spacing="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,22,0,0">
                            <Button x:Name="ActivateNext" Classes="primary" Content="{local:T 'Done, next'}"/>
                            <Button x:Name="ActivateSkip" Classes="link quiet" VerticalAlignment="Center" Content="{local:T 'Already done'}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The app renews itself: what it needs on the iPhone -->
                    <StackPanel x:Name="SelfPage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'It can renew itself'}"/>
                        <TextBlock Classes="sub" Margin="0,10,0,0" FontSize="15.5" LineHeight="23" Text="{local:T 'Apple keeps the app working for 7 days at a time. It can renew itself on the iPhone, with no cable: for that it needs LocalDevVPN, a small free app.'}"/>
                        <StackPanel x:Name="SelfCards" Margin="0,18,0,0" Spacing="10"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                            <local:QrCode x:Name="SelfQr" Width="126" Height="126" Margin="0,0,18,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <TextBlock x:Name="SelfScan" Classes="small" Text="{local:T 'Point the iPhone\'s camera at this code, then tap the yellow button that comes up.'}"/>
                                <StackPanel x:Name="SelfWait" Orientation="Horizontal" Spacing="10">
                                    <local:Spinner Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelfWaitText" Classes="small" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <Button x:Name="SelfNext" Classes="primary"/>
                                    <Button x:Name="SelfLater" Classes="link quiet" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="SelfSideStore" Classes="link quiet" Margin="0,14,0,0" Content="{local:T 'I\'d rather use SideStore'}"/>
                    </StackPanel>

                    <!-- SideStore takes over -->
                    <StackPanel x:Name="SideStorePage" IsVisible="False" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock Classes="h1" Text="{local:T 'Last, on the iPhone'}"/>
                        <TextBlock Classes="sub" Margin="0,12,0,0" Text="{local:T 'Only once. Follow the phone beside this text.'}"/>
                        <StackPanel x:Name="SideStoreCards" Margin="0,22,0,0" Spacing="10"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,18,0,0">
                            <local:QrCode x:Name="SideStoreQr" Width="132" Height="132" Margin="0,0,18,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                <TextBlock x:Name="SideStoreScan" Classes="small" Text="{local:T 'Point the iPhone\'s camera at this code, then tap the yellow button that comes up.'}"/>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button x:Name="SideStoreNext" Classes="primary" Content="{local:T 'Done, next'}"/>
                                    <Button x:Name="SideStoreBack" Classes="link quiet" VerticalAlignment="Center" Content="{local:T 'Back'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Done -->
                    <StackPanel x:Name="DonePage" IsVisible="False" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <TextBlock x:Name="DoneTitle" Classes="h1" FontSize="60" LineHeight="66" Foreground="{StaticResource Brand}" Text="{local:T 'You did it!'}"/>
                        <TextBlock x:Name="DoneText" Classes="sub" FontSize="19" LineHeight="27" Margin="0,14,0,0" Text="{local:T 'Open Ultimate MP3 Player on your iPhone and download your first song.'}"/>
                        <Border Classes="card" Margin="0,24,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DoneUntil" Classes="title"/>
                                <TextBlock x:Name="DoneHint" Classes="small" Foreground="{StaticResource Soft}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="title" Text="{local:T 'Know someone with an iPhone?'}"/>
                                <TextBlock Classes="small" Foreground="{StaticResource Soft}" Text="{local:T 'You\'ve just found out it\'s easy. Send them the link: this program will walk them through it too.'}"/>
                                <Button x:Name="ShareButton" Classes="soft" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="icon" Data="{StaticResource IconCopy}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ShareText" Text="{local:T 'Copy the link for a friend'}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DoneButton" Classes="primary" Margin="0,22,0,0" HorizontalAlignment="Left" Content="{local:T 'Done'}"/>
                    </StackPanel>

                    <!-- Coming back -->
                    <StackPanel x:Name="HomePage" IsVisible="False" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <TextBlock Classes="h1" FontSize="52" LineHeight="58" Text="{local:T 'Welcome back'}"/>
                        <!-- What it needs or doesn't need any more: each opens its notice again. -->
                        <StackPanel x:Name="HomeNotices" Margin="0,18,0,0" Spacing="10" IsVisible="False"/>
                        <Border Classes="card" Margin="0,18,0,0">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="HomePhone" Classes="title" FontSize="18"/>
                                    <local:Badge x:Name="HomePlugged" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="HomeState" Classes="sub" FontSize="15"/>
                                <local:Week x:Name="HomeWeek" Height="8" Margin="0,12,0,4"/>
                                <TextBlock x:Name="HomeExpiry" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HomeHint" Classes="small" Foreground="{StaticResource Soft}" Margin="0,8,0,0" Text="{local:T 'Plugged in and not showing up? Unplug it and plug it in again, with the iPhone unlocked.'}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,20,0,0">
                            <Button x:Name="HomeButton" Classes="primary"/>
                            <Button x:Name="HomeSelf" Classes="soft" Height="56" CornerRadius="28" Content="{local:T 'Let it renew itself'}"/>
                        </StackPanel>
                        <Button x:Name="HomeBring" Classes="link" Margin="0,14,0,-8" Content="{local:T 'Bring everything from this computer'}"/>
                        <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,16,0,0">
                            <Button x:Name="HomeNeeds" Classes="link" Content="{local:T 'What it needs'}"/>
                            <Button x:Name="HomeRepair" Classes="link" Content="{local:T 'Repair SideStore'}"/>
                            <Button x:Name="HomeSideStore" Classes="link"/>
                        </StackPanel>
                        <TextBlock x:Name="HomeAccount" Classes="small" Margin="0,18,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,2,0,0">
                            <Button x:Name="SignOutButton" Classes="link quiet" Content="{local:T 'Sign out of the Apple ID'}"/>
                            <Button x:Name="RemoveButton" Classes="link quiet" Content="{local:T 'Remove everything from this computer'}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- When something goes wrong -->
                    <StackPanel x:Name="ProblemPage" IsVisible="False" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <Path Classes="icon" Data="{StaticResource IconWarn}" Stroke="{StaticResource Warn}" Width="44" Height="44" HorizontalAlignment="Left" StrokeThickness="1.8"/>
                        <TextBlock x:Name="ProblemTitle" Classes="h1" FontSize="38" LineHeight="44" Margin="0,18,0,0"/>
                        <TextBlock x:Name="ProblemText" Classes="sub" Margin="0,12,0,0"/>
                        <Button x:Name="ProblemStatus" Classes="link" Margin="0,8,0,0" IsVisible="False" Content="{local:T 'Is Apple\'s sign-in down? Check its status page'}"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,26,0,0">
                            <Button x:Name="ProblemRetry" Classes="primary" Content="{local:T 'Try again'}"/>
                            <Button x:Name="ProblemOther" Classes="soft" Height="56" CornerRadius="28" Content="{local:T 'Use another Apple ID'}" IsVisible="False"/>
                            <Button x:Name="ProblemBack" Classes="link quiet" VerticalAlignment="Center" Content="{local:T 'Back'}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,18,0,0">
                            <Button x:Name="ProblemDetails" Classes="link quiet" Content="{local:T 'Details'}"/>
                            <Button x:Name="ProblemReport" Classes="link quiet" Content="{local:T 'Report it'}"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <Button x:Name="ToolUpdate" Grid.Row="2" Classes="link" IsVisible="False" HorizontalAlignment="Left" MaxWidth="500"/>
            </Grid>
        </Grid>

        <!-- Where the title bar would be: the window reaches up under it, so this is what drags it. -->
        <Border x:Name="DragStrip" Height="38" VerticalAlignment="Top" Background="Transparent"/>

        <local:Confetti x:Name="Party" IsHitTestVisible="False" IsVisible="False"/>

        <!-- What can't go unnoticed: something that's needed, something that isn't any more, a decision, something to do on the
             iPhone. Always this same box, on the text's side, so that the phone beside it can show what to tap. -->
        <Panel x:Name="NoticeLayer" IsVisible="False" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
            <Border x:Name="NoticeDim"/>
            <Grid ColumnDefinitions="10*,11*">
                <Border x:Name="NoticeBox" Grid.Column="1" Width="500" CornerRadius="26" Background="#1B1826" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,34,0">
                    <StackPanel>
                        <Border x:Name="NoticeEdge" Height="5"/>
                        <StackPanel Margin="34,28,34,30">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border x:Name="NoticeBadge" Width="56" Height="56" CornerRadius="28"/>
                                <TextBlock x:Name="NoticeLabel" Classes="eyebrow" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NoticeTitle" Classes="h1" FontSize="30" LineHeight="36" Margin="0,18,0,0"/>
                            <TextBlock x:Name="NoticeText" Classes="sub" FontSize="16" LineHeight="24" Margin="0,10,0,0"/>
                            <Border x:Name="NoticeCommand" Background="#40000000" CornerRadius="12" Padding="16,10" Margin="0,16,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <SelectableTextBlock x:Name="NoticeCommandText" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button x:Name="NoticeCopy" Grid.Column="1" Classes="link" Margin="14,0,0,0" VerticalAlignment="Center" Content="{local:T 'Copy'}"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="NoticeWait" Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                                <local:Spinner VerticalAlignment="Center"/>
                                <TextBlock x:Name="NoticeWaitText" Classes="small" Foreground="{StaticResource Soft}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel x:Name="NoticeButtons" Margin="0,14,0,0">
                                <Button x:Name="NoticeYes" Classes="primary" Height="50" FontSize="16" CornerRadius="25" Padding="28,0" Margin="0,8,14,0"/>
                                <Button x:Name="NoticeNo" Classes="soft" Height="50" CornerRadius="25" Margin="0,8,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>

        <!-- A sheet over everything, for what's worth reading only if you want to. -->
        <Panel x:Name="Sheet" IsVisible="False" Opacity="0">
            <Border x:Name="SheetDim" Background="#99000000"/>
            <Border x:Name="SheetBox" Width="560" MaxHeight="650" CornerRadius="26" Background="#1B1826" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="34,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 24 60 0 #80000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="SheetTitle" Classes="h1" FontSize="28" LineHeight="34"/>
                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" MaxHeight="476">
                        <StackPanel>
                            <SelectableTextBlock x:Name="SheetText" FontSize="15.5" LineHeight="23" Foreground="{StaticResource Soft}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="SheetRows" Spacing="12" Margin="0,0,14,0" IsVisible="False"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,22,0,0">
                        <Button x:Name="SheetClose" Classes="soft" Content="{local:T 'Close'}"/>
                        <Button x:Name="SheetCopy" Classes="soft" Content="{local:T 'Copy details'}" IsVisible="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>
    </Panel>
</Window>
